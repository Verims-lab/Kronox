{
  "name": "EconomyOperationLock",
  "type": "object",
  "description": "Short-lived backend-owned guard for player economy mutations. Public UI and exports must never expose actor_key or lock_key.",
  "properties": {
    "lock_key": {
      "type": "string",
      "description": "Internal per-player lock key."
    },
    "actor_key": {
      "type": "string",
      "description": "Internal normalized economy actor key. Never public."
    },
    "operation_scope": {
      "type": "string",
      "enum": [
        "login_bonus_grant",
        "market_purchase",
        "solo_joker_spend",
        "solo_hint_spend",
        "solo_streak_reward",
        "daily_wheel_claim",
        "daily_calendar_streak_claim",
        "daily_quest_claim",
        "daily_calendar_assignment",
        "online_match_result",
        "lobby_create",
        "lobby_join",
        "lobby_leave",
        "lobby_start",
        "lobby_turn",
        "admin_diamond_grant"
      ],
      "description": "Guarded operation type."
    },
    "operation_id": {
      "type": "string",
      "description": "Debug-safe operation id."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "released",
        "stale"
      ],
      "description": "Lock lifecycle."
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Debug-safe metadata without secrets or private/public identity payloads."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional admin/audit note."
    }
  },
  "required": [
    "lock_key",
    "actor_key",
    "operation_scope",
    "operation_id",
    "status",
    "acquired_at",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}