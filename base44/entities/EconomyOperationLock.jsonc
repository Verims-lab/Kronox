{
  "name": "EconomyOperationLock",
  "type": "object",
  "description": "Short-lived backend-owned guard for economy, Daily, matchmaking, and Lobby mutations. Public UI and exports never expose actor_key or lock_key.",
  "properties": {
    "lock_key": {
      "type": "string",
      "description": "Internal deterministic operation lock key."
    },
    "actor_key": {
      "type": "string",
      "description": "Private normalized actor key."
    },
    "operation_scope": {
      "type": "string",
      "enum": [
        "login_bonus_grant",
        "market_purchase",
        "solo_joker_spend",
        "solo_hint_spend",
        "solo_streak_reward",
        "daily_wheel_claim",
        "daily_calendar_streak_claim",
        "daily_quest_claim",
        "daily_calendar_assignment",
        "online_match_result",
        "random_matchmaking_pair",
        "lobby_create",
        "lobby_join",
        "lobby_leave",
        "lobby_start",
        "lobby_turn",
        "admin_diamond_grant"
      ],
      "description": "Guarded backend operation type. same_question_duel arbitration reuses lobby_turn."
    },
    "operation_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "released",
        "stale"
      ]
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Backend-private operation metadata. Matchmaking fallback rows may contain hashed internal actor references; public UI and exports must never expose this object."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "lock_key",
    "actor_key",
    "operation_scope",
    "operation_id",
    "status",
    "acquired_at",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
