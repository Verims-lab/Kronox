{
  "name": "Lobby",
  "type": "object",
  "description": "Backend-authoritative Online lobby and match state. Standard Online and same_question_duel share this entity while mode-specific fields remain additive and private unless explicitly sanitized by lobby functions.",
  "properties": {
    "public_ref": {
      "type": "string",
      "description": "Opaque client-safe lobby reference."
    },
    "code": {
      "type": "string",
      "description": "Six-character compatibility lobby code."
    },
    "game_mode": {
      "type": "string",
      "enum": [
        "random_online",
        "same_question_duel"
      ],
      "default": "random_online",
      "description": "Online mode. same_question_duel is the independent random-opponent, exactly two-player shared-timeline V2."
    },
    "host_email": {
      "type": "string",
      "description": "Private backend-only linked host email."
    },
    "host_actor_key_hash": {
      "type": "string",
      "description": "Private backend host actor key."
    },
    "host_kronox_user_id": {
      "type": "string",
      "description": "Private immutable host reference."
    },
    "host_name": {
      "type": "string",
      "description": "Public username snapshot for the host."
    },
    "players": {
      "type": "array",
      "description": "Embedded authoritative participant state.",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Private linked-player routing field."
          },
          "actor_key_hash": {
            "type": "string",
            "description": "Private participant authority key."
          },
          "participant_ref": {
            "type": "string",
            "description": "Opaque public participant reference."
          },
          "player_type": {
            "type": "string",
            "enum": [
              "linked",
              "guest"
            ]
          },
          "kronox_user_id": {
            "type": "string",
            "description": "Private immutable participant reference."
          },
          "name": {
            "type": "string",
            "description": "Public username snapshot."
          },
          "avatar_type": {
            "type": "string",
            "enum": [
              "",
              "icon",
              "photo"
            ]
          },
          "avatar_icon_id": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string"
          },
          "avatar_color_id": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "claimed_count": {
            "type": "number",
            "minimum": 0,
            "description": "Legacy-compatible alias of correct_count for same_question_duel V2."
          },
          "correct_count": {
            "type": "number",
            "minimum": 0,
            "description": "Backend-confirmed Duello V2 correct-answer count."
          },
          "total_correct_response_time_ms": {
            "type": "number",
            "minimum": 0,
            "description": "Diagnostic-only total response time for correct Duello answers. Never awards points or breaks ties."
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "year": {
                  "type": "number"
                },
                "question": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "media_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "starting",
        "in_game",
        "finished",
        "cancelled",
        "expired"
      ],
      "default": "waiting"
    },
    "winner": {
      "type": "string",
      "description": "Sanitized winner username."
    },
    "winner_email": {
      "type": "string",
      "description": "Private backend winner routing field."
    },
    "winner_kronox_user_id": {
      "type": "string",
      "description": "Private immutable winner reference."
    },
    "winner_actor_key_hash": {
      "type": "string",
      "description": "Private authoritative winner actor key."
    },
    "winner_participant_ref": {
      "type": "string",
      "description": "Opaque public winner reference."
    },
    "state_revision": {
      "type": "number",
      "description": "Monotonic multiplayer state revision."
    },
    "last_operation_key": {
      "type": "string",
      "description": "Latest private mutation idempotency key."
    },
    "duel_processed_operation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bounded private idempotency window for same-question submissions."
    },
    "duel_sequence": {
      "type": "number",
      "minimum": 1,
      "description": "Current Duello V2 shared question index, bounded to 12."
    },
    "duel_rules_version": {
      "type": "string",
      "description": "Duello rules contract version; current value is duello_shared_timeline_v2."
    },
    "duel_match_state": {
      "type": "string",
      "enum": [
        "MATCHING",
        "COUNTDOWN",
        "QUESTION_ACTIVE",
        "WAITING_FOR_OPPONENT",
        "ROUND_RESULT",
        "SUDDEN_DEATH",
        "MATCH_FINISHED"
      ],
      "description": "Backend-authoritative simultaneous Duello lifecycle state."
    },
    "duel_shared_timeline": {
      "type": "array",
      "description": "Single authoritative timeline shared by both Duello players and grown after every resolved round.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "year": { "type": "number" },
          "question": { "type": "string" },
          "type": { "type": "string" },
          "media_url": { "type": "string" }
        }
      }
    },
    "duel_round_answers": {
      "type": "array",
      "description": "Private per-round locked answer rows. Public DTOs expose only booleans and result state.",
      "items": {
        "type": "object",
        "properties": {
          "actor_key_hash": { "type": "string" },
          "participant_ref": { "type": "string" },
          "placement_zone": { "type": "number" },
          "answered_at": { "type": "string", "format": "date-time" },
          "response_ms": { "type": "number" },
          "correct": { "type": "boolean" }
        }
      }
    },
    "duel_question_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duel_question_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative 10-second round deadline shared by both clients."
    },
    "duel_countdown_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "duel_round_resolve_after": {
      "type": "string",
      "format": "date-time",
      "description": "Backend transition time after the approximately 0.8-second result feedback window."
    },
    "duel_round_result": {
      "type": "object",
      "description": "Resolved round feedback projected without private actor keys."
    },
    "duel_pending_finish": {
      "type": "object",
      "description": "Private finish decision held until round feedback completes."
    },
    "duel_sudden_death": {
      "type": "boolean",
      "description": "True after a simultaneous 5-5 target round until a differential result or question 12."
    },
    "duel_result_type": {
      "type": "string",
      "enum": ["win", "draw"]
    },
    "duel_result_reason": {
      "type": "string",
      "enum": ["target", "sudden_death", "max_questions", "draw"]
    },
    "duel_points_awarded": {
      "type": "number",
      "minimum": 0,
      "description": "Backend winner award: 50 for target/Sudden Death, 25 for question-12 non-target winner, or 0 for draw/loser."
    },
    "duel_round_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy private compatibility projection. Duello V2 authority is duel_round_answers."
    },
    "recent_claim": {
      "type": "object",
      "description": "Legacy V1 claim state. Duello V2 serializers always return recent_claim null.",
      "properties": {
        "participant_ref": {
          "type": "string"
        },
        "sequence_id": {
          "type": "number"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "skipped": {
          "type": "boolean"
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "karisik",
        "tarih",
        "bilim",
        "spor",
        "sanat"
      ],
      "default": "karisik",
      "description": "Legacy compatibility field."
    },
    "selected_category_ids": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy compatibility field; current Online uses all active categories."
    },
    "year_start": {
      "type": "number",
      "default": 1900
    },
    "year_end": {
      "type": "number",
      "default": 2020
    },
    "turn_duration": {
      "type": "number",
      "default": 60
    },
    "win_card_count": {
      "type": "number",
      "default": 10
    },
    "current_player_index": {
      "type": "number",
      "default": 0
    },
    "current_question_id": {
      "type": "string",
      "description": "Current server-authored shared question id."
    },
    "used_question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "online_question_deck": {
      "type": "array",
      "description": "Private bounded server-authored Online deck. same_question_duel public snapshots expose only the active shared card.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "media_url": {
            "type": "string"
          },
          "main_category_id": {
            "type": "number"
          },
          "difficulty": {
            "type": "number"
          }
        }
      }
    },
    "online_deck_meta": {
      "type": "object",
      "description": "Safe bounded deck metadata without full-bank content."
    },
    "max_players": {
      "type": "number",
      "description": "Standard Online supports 2-4; same_question_duel requires exactly 2."
    },
    "invited_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Private invitation compatibility field."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
