{
  "name": "Lobby",
  "type": "object",
  "description": "Backend-authoritative Online lobby and match state. Standard Online and same_question_duel share this entity while mode-specific fields remain additive and private unless explicitly sanitized by lobby functions.",
  "properties": {
    "public_ref": {
      "type": "string",
      "description": "Opaque client-safe lobby reference."
    },
    "code": {
      "type": "string",
      "description": "Six-character compatibility lobby code."
    },
    "game_mode": {
      "type": "string",
      "enum": [
        "random_online",
        "same_question_duel"
      ],
      "default": "random_online",
      "description": "Online mode. same_question_duel is random-opponent, exactly two-player V1."
    },
    "host_email": {
      "type": "string",
      "description": "Private backend-only linked host email."
    },
    "host_actor_key_hash": {
      "type": "string",
      "description": "Private backend host actor key."
    },
    "host_kronox_user_id": {
      "type": "string",
      "description": "Private immutable host reference."
    },
    "host_name": {
      "type": "string",
      "description": "Public username snapshot for the host."
    },
    "players": {
      "type": "array",
      "description": "Embedded authoritative participant state.",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Private linked-player routing field."
          },
          "actor_key_hash": {
            "type": "string",
            "description": "Private participant authority key."
          },
          "participant_ref": {
            "type": "string",
            "description": "Opaque public participant reference."
          },
          "player_type": {
            "type": "string",
            "enum": [
              "linked",
              "guest"
            ]
          },
          "kronox_user_id": {
            "type": "string",
            "description": "Private immutable participant reference."
          },
          "name": {
            "type": "string",
            "description": "Public username snapshot."
          },
          "avatar_type": {
            "type": "string",
            "enum": [
              "",
              "icon",
              "photo"
            ]
          },
          "avatar_icon_id": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string"
          },
          "avatar_color_id": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "claimed_count": {
            "type": "number",
            "minimum": 0,
            "description": "same_question_duel cards claimed through backend-confirmed first-correct arbitration. Opening anchors do not count."
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "year": {
                  "type": "number"
                },
                "question": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "media_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "starting",
        "in_game",
        "finished",
        "cancelled",
        "expired"
      ],
      "default": "waiting"
    },
    "winner": {
      "type": "string",
      "description": "Sanitized winner username."
    },
    "winner_email": {
      "type": "string",
      "description": "Private backend winner routing field."
    },
    "winner_kronox_user_id": {
      "type": "string",
      "description": "Private immutable winner reference."
    },
    "winner_actor_key_hash": {
      "type": "string",
      "description": "Private authoritative winner actor key."
    },
    "winner_participant_ref": {
      "type": "string",
      "description": "Opaque public winner reference."
    },
    "state_revision": {
      "type": "number",
      "description": "Monotonic multiplayer state revision."
    },
    "last_operation_key": {
      "type": "string",
      "description": "Latest private mutation idempotency key."
    },
    "duel_processed_operation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bounded private idempotency window for same-question submissions."
    },
    "duel_sequence": {
      "type": "number",
      "minimum": 1,
      "description": "Current same-question shared-card sequence."
    },
    "duel_round_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Private actor keys that already answered the current duel card incorrectly."
    },
    "recent_claim": {
      "type": "object",
      "description": "Safe claim event state; backend DTO personalizes claimed_by_self and never returns private actor keys.",
      "properties": {
        "participant_ref": {
          "type": "string"
        },
        "sequence_id": {
          "type": "number"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "skipped": {
          "type": "boolean"
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "karisik",
        "tarih",
        "bilim",
        "spor",
        "sanat"
      ],
      "default": "karisik",
      "description": "Legacy compatibility field."
    },
    "selected_category_ids": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy compatibility field; current Online uses all active categories."
    },
    "year_start": {
      "type": "number",
      "default": 1900
    },
    "year_end": {
      "type": "number",
      "default": 2020
    },
    "turn_duration": {
      "type": "number",
      "default": 60
    },
    "win_card_count": {
      "type": "number",
      "default": 10
    },
    "current_player_index": {
      "type": "number",
      "default": 0
    },
    "current_question_id": {
      "type": "string",
      "description": "Current server-authored shared question id."
    },
    "used_question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "online_question_deck": {
      "type": "array",
      "description": "Private bounded server-authored Online deck. same_question_duel public snapshots expose only the active shared card.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "media_url": {
            "type": "string"
          },
          "main_category_id": {
            "type": "number"
          },
          "difficulty": {
            "type": "number"
          }
        }
      }
    },
    "online_deck_meta": {
      "type": "object",
      "description": "Safe bounded deck metadata without full-bank content."
    },
    "max_players": {
      "type": "number",
      "description": "Standard Online supports 2-4; same_question_duel requires exactly 2."
    },
    "invited_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Private invitation compatibility field."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}