{
  "name": "DiamondTransaction",
  "type": "object",
  "description": "Codex152/Codex594 \u2014 User-owned Diamond economy ledger. One logical row should exist per idempotency_key. Solo streak rewards use source solo_streak and fixed per-attempt milestone keys.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Lowercased owner email for registered users, or internal guest player key guest:<g_owner_key> for token-proven completed guest profiles. Never use this as public identity."
    },
    "owner_key": {
      "type": "string",
      "description": "Optional internal owner key for audit/account-link correlation. Public APIs must not expose it."
    },
    "kronox_user_id": {
      "type": "string",
      "description": "Immutable Kronox ID of the economy owner when available. Admin/private audit field."
    },
    "player_type": {
      "type": "string",
      "enum": [
        "registered",
        "guest"
      ],
      "description": "Internal economy owner type."
    },
    "amount": {
      "type": "number",
      "description": "Positive Diamond amount represented by this transaction."
    },
    "balance_before": {
      "type": "number",
      "description": "Canonical player Diamond balance before this transaction."
    },
    "balance_after": {
      "type": "number",
      "description": "Canonical player Diamond balance after this transaction."
    },
    "source": {
      "type": "string",
      "enum": [
        "starter_bonus",
        "first_login_reward",
        "daily_login",
        "daily_wheel",
        "solo_streak",
        "market_purchase",
        "account_link_merge",
        "daily_quest_reward",
        "daily_calendar_streak_reward",
        "daily_quest_future",
        "wheel_spin_future",
        "rewarded_ad_future",
        "quest_reward_future",
        "purchase_future",
        "achievement_future",
        "special_event_future",
        "admin_adjustment"
      ],
      "description": "Economy source. solo_streak is the Solo-only clean-answer milestone reward and never changes Kronox Puan, Leaderboard, or Daily Goals."
    },
    "direction": {
      "type": "string",
      "enum": [
        "earn",
        "spend"
      ],
      "description": "earn for granted Diamonds, spend for costs."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Durable logical unique idempotency key."
    },
    "metadata": {
      "type": "object",
      "description": "Debug-safe metadata. Must not contain secrets, raw auth tokens, or public/private identity payloads."
    },
    "related_entity_type": {
      "type": "string",
      "description": "Optional related economy entity type."
    },
    "related_entity_id": {
      "type": "string",
      "description": "Optional related entity id or idempotency key."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the transaction row was created."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description for this transaction."
    }
  },
  "required": [
    "user_email",
    "amount",
    "balance_before",
    "balance_after",
    "source",
    "direction",
    "idempotency_key",
    "created_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}