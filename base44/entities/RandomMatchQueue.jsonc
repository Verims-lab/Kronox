{
  "name": "RandomMatchQueue",
  "type": "object",
  "description": "Backend-owned Online random matchmaking queue. Queue rows are isolated by mode; public responses expose only opaque queue/lobby references and never private actor identity.",
  "properties": {
    "queue_ref": {
      "type": "string",
      "description": "Opaque client-facing queue reference."
    },
    "actor_key_hash": {
      "type": "string",
      "description": "Private backend actor key. Never public."
    },
    "mode": {
      "type": "string",
      "enum": [
        "random_online",
        "same_question_duel"
      ],
      "default": "random_online",
      "description": "Mode-scoped queue lane. Legacy missing values normalize to random_online."
    },
    "player_type": {
      "type": "string",
      "enum": [
        "linked",
        "guest"
      ],
      "description": "Actor type at queue time."
    },
    "kronox_user_id": {
      "type": "string",
      "description": "Private immutable player reference when available."
    },
    "public_username": {
      "type": "string",
      "description": "Sanitized username copied by the backend for matched Lobby display. Never accepts email or private identity fields."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "pairing",
        "matched",
        "consumed",
        "cancelled",
        "expired"
      ],
      "default": "waiting"
    },
    "lobby_id": {
      "type": "string",
      "description": "Private internal Lobby row id."
    },
    "lobby_public_ref": {
      "type": "string",
      "description": "Opaque matched Lobby public_ref."
    },
    "lobby_code": {
      "type": "string",
      "description": "Compatibility lobby code; not primary matchmaking UI."
    },
    "is_host": {
      "type": "boolean",
      "default": false
    },
    "paired_actor_key_hash": {
      "type": "string",
      "description": "Private paired actor key. Never public."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "matched_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "queue_ref",
    "actor_key_hash",
    "mode",
    "player_type",
    "status",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
